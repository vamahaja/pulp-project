# Pulp Namespace
PULP_NAMESPACE="<your-pulp-namespace>"

# Route Host
PULP_ROUTE_HOST="<your-route-host>"

# Storage class (Postgres, Redis, and file storage; file storage requires ReadWriteMany)
STORAGE_CLASS="<your-storage-class>"

# File storage size in Gi (numeric only, e.g. 100)
PULP_STORAGE_SIZE="<your-file-storage-size>"

# Pulp admin password (applied via pulp-secrets.yaml)
PULP_ADMIN_PASSWORD="<your-pulp-admin-password>"

# cert-manager ClusterIssuer name (self-signed issuer defined in pulp-cert.yaml)
CERT_MANAGER_ISSUER_NAME="<your-cluster-issuer-name>"
